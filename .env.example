# ---- Outlook provider: Microsoft app registration (see README "Setup") ----
MS_CLIENT_ID=00000000-0000-0000-0000-000000000000
MS_CLIENT_SECRET=

# consumers = personal Microsoft accounts only (outlook.com / hotmail / live)
# common    = personal + work/school
MS_TENANT=consumers

# Must exactly match a Redirect URI on the app registration.
MS_REDIRECT_URI=http://localhost:8080/oauth/callback

# Space-separated. offline_access is what earns a refresh token — without it the
# integration dies about an hour after connecting.
MS_SCOPES=offline_access openid profile User.Read Mail.Read Mail.ReadWrite Mail.Send

# ---- this service ----
# Ignored when the host sets PORT (Vercel, Railway, Render, Heroku, Cloud Run
# all assign the port at runtime and health-check it); that port wins.
LISTEN_ADDR=:8080

# ---- database ----
# sqlite   = a local file at DB_PATH (the default; nothing else to set up)
# postgres = a managed database at DATABASE_URL (Supabase, RDS, …)
DB_DRIVER=sqlite

# Where the SQLite file lives. Ignored when DB_DRIVER=postgres.
DB_PATH=./unified-messaging.db

# Required when DB_DRIVER=postgres, ignored otherwise. Supabase gives this
# under Project Settings -> Database -> Connection string (URI). Keep
# sslmode=require: the connection carries sealed tokens and session ids.
#
# It is parsed as a URL, so a password containing any of  @ # ? / : & % + [ ]
# or a space MUST be percent-encoded (@ -> %40, # -> %23, ? -> %3F, / -> %2F,
# space -> %20, ...). Some of these fail loudly at startup ("invalid userinfo"
# or "invalid URL escape"); others (# ? / in particular) don't error at all —
# they are URL syntax themselves, so an unescaped one silently truncates the
# URL there and the server connects to the wrong host or database instead of
# refusing to start. Either way, this service also detects and repairs a
# not-yet-encoded password on the way in, but percent-encoding it yourself
# when you set this variable is the reliable way to avoid both failure modes.
# DATABASE_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres?sslmode=require

# Connection pool cap. Ignored on sqlite, which is pinned to a single writer.
# Keep it under whatever the provider allows — Supabase's pooler included.
DB_MAX_OPEN_CONNS=10

# 32 bytes, base64. Generate with:  openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Dashboard login sessions last this many days without use.
SESSION_TTL_DAYS=30

# Absolute lifetime of a dashboard session, in days: however actively it is
# used, it expires this long after sign-in and the developer signs in again.
SESSION_MAX_AGE_DAYS=90

# Set to any value for exhaustive debug logging (inputs, decisions, outputs;
# secrets are always redacted).
DEBUG=

# REQUIRED: this deployment's own origin. The server refuses to start without
# it, because it is the origin the hosted-auth redirect allowlist exempts —
# there is no safe fallback for that (the request's Host header is set by the
# caller). http://localhost:8080 is the value for a local run.
#
# Point it at a public HTTPS origin Microsoft Graph can reach to turn on push
# notifications; anything else (localhost included) runs on delta polling
# alone. To get one locally:
#   cloudflared tunnel --url http://localhost:8080
PUBLIC_BASE_URL=http://localhost:8080

# ---- sync tuning ----
BACKFILL_DAYS=30
POLL_INTERVAL_SECONDS=120

# ---- WhatsApp provider (linked-device model, like WhatsApp Web) ----
# Off by default: it opens a socket per linked account and stores whatsmeow's
# device keys UNSEALED in this service's SQLite file — see README "Providers"
# before turning this on, and encrypt the disk/DB if you do.
WHATSAPP_ENABLED=false

# Live sockets held open at once, across every developer's linked accounts.
WHATSAPP_MAX_ACCOUNTS=200

# Shown to the end user in WhatsApp's own "Linked devices" list after pairing.
WHATSAPP_DEVICE_NAME=Unified Messaging

# How long an abandoned (dead) webhook delivery is kept before the hourly
# purge deletes it. A dead delivery still carries the full message payload it
# failed to send, so this bounds how long that content stays in the database.
DELIVERY_RETENTION_DAYS=7

# ---- reverse proxy ----
# Only set this to true when the service sits behind a TLS-terminating proxy
# that strips any client-supplied X-Forwarded-Proto before setting its own —
# otherwise a client can spoof "https" and downgrade HSTS/Secure-cookie checks.
# TRUST_PROXY=true
